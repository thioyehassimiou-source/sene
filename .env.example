# ==============================================================================
# SÈNÈ PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=Sènè
APP_PORT=4000
FRONTEND_PORT=3000

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_DB=sene_db
POSTGRES_USER=sene_admin
POSTGRES_PASSWORD=sene_secure_password_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sene_admin:sene_secure_password_2026@localhost:5432/sene_db?schema=public

# ==============================================================================
# REDIS (BullMQ & Cache)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sene_redis_secret

# ==============================================================================
# OBJECT STORAGE (MinIO S3-Compatible)
# ==============================================================================
MINIO_ROOT_USER=sene_minio_admin
MINIO_ROOT_PASSWORD=sene_minio_password_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sene_minio_admin
MINIO_SECRET_KEY=sene_minio_password_2026
MINIO_BUCKET_PRODUCERS=sene-producers
MINIO_BUCKET_CROPS=sene-crops
MINIO_BUCKET_DELIVERIES=sene-deliveries

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT & Secrets)
# ==============================================================================
# Generate secure 64-character random keys in production
JWT_SECRET=sene_dev_jwt_secret_change_in_production_min32chars
JWT_EXPIRATION=86400s
JWT_REFRESH_SECRET=sene_dev_refresh_secret_change_in_production
JWT_REFRESH_EXPIRATION=604800s
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ==============================================================================
# PAYMENT PROVIDERS (Guinea Mobile Money & Escrow)
# ==============================================================================
# Options: MOCK | ORANGE_MONEY_GN | MTN_MOMO_GN
PAYMENT_DEFAULT_PROVIDER=MOCK
ORANGE_MONEY_GN_CLIENT_ID=mock_om_client_id
ORANGE_MONEY_GN_CLIENT_SECRET=mock_om_client_secret
ORANGE_MONEY_GN_MERCHANT_KEY=mock_om_merchant_key
MTN_MOMO_GN_API_KEY=mock_momo_api_key
MTN_MOMO_GN_USER_ID=mock_momo_user_id
MTN_MOMO_GN_SUBSCRIPTION_KEY=mock_momo_sub_key

# Platform commission percentage (e.g. 5 = 5%)
PLATFORM_COMMISSION_PERCENT=5
AGENT_COMMISSION_PERCENT=3

# ==============================================================================
# NOTIFICATION PROVIDERS (SMS & WhatsApp)
# ==============================================================================
# Options: MOCK | ORANGE_SMS_GN | TWILIO | META_WHATSAPP
SMS_DEFAULT_PROVIDER=MOCK
WHATSAPP_DEFAULT_PROVIDER=MOCK
ORANGE_SMS_GN_CLIENT_ID=mock_orange_sms_client_id
ORANGE_SMS_GN_CLIENT_SECRET=mock_orange_sms_client_secret
TWILIO_ACCOUNT_SID=mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
META_WHATSAPP_PHONE_NUMBER_ID=mock_whatsapp_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=mock_whatsapp_access_token

# ==============================================================================
# FRONTEND PUBLIC VARIABLES
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Sènè Plateforme Agricole"
